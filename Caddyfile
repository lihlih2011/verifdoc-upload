# Configuration Caddy (Serveur Web & HTTPS automatique)

# --------------------------------------------------------
# Mode HTTP simple pour éviter les erreurs SSL sur IP brute
:80 {
    # Pas de TLS/HTTPS pour l'instant
    # tls internal  <-- Commenté pour fixer l'erreur ERR_SSL_PROTOCOL_ERROR
    
    encode gzip
    # Compression Gzip pour la vitesse
    encode gzip

    # 1. API Backend : tout ce qui commence par /api va vers le conteneur backend
    handle_path /api/* {
        reverse_proxy backend:8000
    }

    # Docs Swagger (optionnel, pour debug)
    handle_path /docs* {
        reverse_proxy backend:8000
    }
    
    handle_path /openapi.json {
        reverse_proxy backend:8000
    }

    # 2. Frontend : tout le reste va vers le site React
    handle {
        reverse_proxy frontend:80
    }
}
